{
    "name": "MMYOLO Dev Container",
    "context": "..",
    "dockerFile": "../docker/Dockerfile.train",
    "workspaceFolder": "/mmyolo",
    "runArgs": [
        "--gpus=all",
        "--shm-size=16g"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-azuretools.vscode-docker",
                "eamodio.gitlens",
                "njpwerner.autodocstring",
                "ms-toolsai.jupyter",
                "yzhang.markdown-all-in-one"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python",
                "python.terminal.activateEnvironment": true,
                "python.linting.enabled": true,
                "python.linting.flake8Enabled": true,
                "python.linting.pylintEnabled": false,
                "python.formatting.provider": "black",
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.organizeImports": true
                },
                "files.autoSave": "onFocusChange",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder},target=/mmyolo,type=bind",
        "source=${env:HOME}/.cache,target=/root/.cache,type=bind"
    ],
    //"postCreateCommand": "pip install -e . && pip install onnxruntime",
    // ДОБАВЛЯЕМ ЭТУ СЕКЦИЮ:
    "postStartCommand": "sed -i 's/checkpoint = torch.load(filename, map_location=map_location)/checkpoint = torch.load(filename, map_location=map_location, weights_only=False)/' /opt/conda/lib/python3.11/site-packages/mmengine/runner/checkpoint.py && echo '✅ Checkpoint fix applied'",
    "remoteUser": "root",
    "containerEnv": {
        "DEBIAN_FRONTEND": "noninteractive",
        "FORCE_CUDA": "1",
        "PYTHONPATH": "/mmyolo:/opt/conda/lib/python3.11/site-packages"
    }
}